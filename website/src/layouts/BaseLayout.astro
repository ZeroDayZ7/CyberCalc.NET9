---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const {
  title,
  description,
  image = 'cybercalc-2.1.7.png'
} = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const imageUrl = `${baseUrl}${image}`;
const canonical = 'https://zerodayz7.github.io/CyberCalc.NET9/';
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080b12" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`https://zerodayz7.github.io${imageUrl}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`https://zerodayz7.github.io${imageUrl}`} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
  </head>
  <body>
    <slot />
  </body>
</html>
